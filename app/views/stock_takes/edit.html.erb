<% content_for :title, "棚卸 (#{@stock_take.storage_location_name})" %>

<p class="text-sm">
  <%= link_to "← 棚卸", stock_takes_path, class: "text-blue-600 underline" %>
</p>

<h1 class="mt-2 text-2xl font-bold text-slate-900">
  <%= @stock_take.storage_location_name %>を数える
</h1>
<p class="<%= hint_classes %>">
  棚卸日: <%= l(@stock_take.counted_on) %> ・ 実物の数を入れてください。
  <strong>空のままにした品目はそのまま (変更なし) になります。</strong>
  確定するまで在庫は変わりません。
  書き換えた欄だけが保存されるので、ほかの人が先に入れた実数は消えません。
</p>

<% if @items.empty? %>
  <p class="mt-6 rounded-xl border border-slate-200 bg-white p-4 text-sm text-slate-600">
    この保管場所の品目がありません。品目の保管場所を設定してから数え直してください。
  </p>
<% else %>
  <%= form_with url: stock_take_path(@stock_take), method: :patch, class: "mt-6" do |form| %>
    <ul class="divide-y divide-slate-200 overflow-hidden rounded-xl border border-slate-200 bg-white"
        aria-label="棚卸の品目一覧">
      <% @items.each do |item| %>
        <% lots = @lots_by_item_id[item.id] || [] %>
        <li class="p-4">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="font-medium text-slate-900"><%= item.name %></p>
              <%# 記録在庫は薄く出す (実数の入力に引きずられないように) %>
              <p class="mt-1 text-sm text-slate-400">
                記録在庫 <%= item.current_quantity %> <%= item.unit %>
              </p>
            </div>
            <div class="w-28 shrink-0">
              <%# ラベルは読み上げ用に隠す (見た目は行の品目名で分かる) %>
              <%= label_tag "counts_#{item.id}_total", "「#{item.name}」の実数", class: "sr-only" %>
              <%#
                画面に出したときの値。サーバはこれと違う欄だけを書き換えるので、
                古い画面を送り直しても、ほかのタブ・ほかの人の入力を消さない
              %>
              <%= hidden_field_tag "counts[#{item.id}][was]",
                    @entries_by_key[[ item.id, nil ]]&.counted_quantity, id: nil %>
              <%= number_field_tag "counts[#{item.id}][total]",
                    stock_take_count_value(@submitted_counts, @entries_by_key[[ item.id, nil ]],
                      item.id.to_s, "total"),
                    id: "counts_#{item.id}_total", min: 0, inputmode: "numeric",
                    placeholder: "未入力",
                    class: field_classes("mt-0 text-center text-lg") %>
            </div>
          </div>

          <%#
            ロット別に数えられるのは、期限を管理していてロットが 2 件以上ある品目だけ
            (docs/spec/01-domain-model.md 判断 3)。数え間違いの原因になるロット識別を
            すべての品目に強いない
          %>
          <%# すでにロット別に数えていれば、ロットが 1 件になっても開いたまま出す %>
          <% counted_by_lot = lots.any? { |lot| @entries_by_key[[ item.id, lot.id ]] } %>
          <% if item.tracks_expiry? && (lots.size >= 2 || counted_by_lot) %>
            <details class="group mt-3 border-t border-slate-200 pt-3" <%= "open" if counted_by_lot %>>
              <summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 py-2 text-sm font-medium text-slate-700">
                <span class="text-slate-400 transition-transform group-open:rotate-90" aria-hidden="true">▶</span>
                <span>ロット別に数える (<%= lots.size %> 件)</span>
              </summary>
              <p class="<%= hint_classes %>">
                ロット別に入れると、上の合計の入力は使いません。
              </p>
              <ul class="mt-2 divide-y divide-slate-100">
                <% lots.each do |lot| %>
                  <% expiry_label = lot.expires_on ? "期限 #{l(lot.expires_on)}" : "期限なし" %>
                  <li class="flex items-center justify-between gap-3 py-2">
                    <span class="min-w-0 text-sm text-slate-600">
                      <%= expiry_label %>
                      <span class="text-slate-400">・ 記録 <%= lot.remaining_quantity %> <%= item.unit %></span>
                    </span>
                    <span class="w-24 shrink-0">
                      <%= label_tag "counts_#{item.id}_lots_#{lot.id}",
                            "「#{item.name}」の#{expiry_label}のロットの実数", class: "sr-only" %>
                      <%= hidden_field_tag "counts[#{item.id}][lots_was][#{lot.id}]",
                            @entries_by_key[[ item.id, lot.id ]]&.counted_quantity, id: nil %>
                      <%= number_field_tag "counts[#{item.id}][lots][#{lot.id}]",
                            stock_take_count_value(@submitted_counts,
                              @entries_by_key[[ item.id, lot.id ]],
                              item.id.to_s, "lots", lot.id.to_s),
                            id: "counts_#{item.id}_lots_#{lot.id}", min: 0, inputmode: "numeric",
                            placeholder: "未入力",
                            class: field_classes("mt-0 text-center") %>
                    </span>
                  </li>
                <% end %>
              </ul>
            </details>
          <% end %>
        </li>
      <% end %>
    </ul>

    <div class="mt-6 space-y-2">
      <%= form.submit "確認へ進む", class: primary_button_classes %>
      <%# 全部を一度に数えきれないので、途中で保存してあとから続けられるようにする %>
      <%= form.submit "途中保存", name: "continue", class: secondary_button_classes("w-full cursor-pointer") %>
    </div>
  <% end %>
<% end %>

<section class="mt-6 rounded-xl border border-slate-200 bg-white p-4">
  <h2 class="font-bold text-slate-900">この棚卸をやめる</h2>
  <p class="<%= hint_classes %>">下書きを削除します。在庫は変わりません。</p>
  <%= button_to "下書きを削除", stock_take_path(@stock_take), method: :delete,
        form: { data: { turbo_confirm: "この棚卸の下書きを削除します。よろしいですか?" } },
        class: danger_button_classes("mt-3") %>
</section>
