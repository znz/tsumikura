<% content_for :title, "カテゴリを編集" %>

<h1 class="text-2xl font-bold text-slate-900">カテゴリを編集</h1>

<%= render "form", category: @category, submit_label: "保存" %>

<%# 削除は nullify。確認ダイアログ (JS) だけに頼らず、外れる件数をサーバ側で出す %>
<section class="mt-8 rounded-xl border border-red-200 bg-white p-4">
  <h2 class="font-bold text-red-700">このカテゴリを削除</h2>
  <p class="mt-2 text-sm text-slate-600">
    削除すると <%= @category.items.count %> 件の品目からカテゴリが外れます。品目は消えません。
  </p>
  <%= button_to "削除する", category_path(@category), method: :delete,
        form: { data: { turbo_confirm: "カテゴリ「#{@category.name}」を削除します。よろしいですか?" } },
        class: danger_button_classes("mt-3") %>
</section>

<%= link_to "カテゴリ一覧に戻る", categories_path, class: "mt-6 inline-flex min-h-11 items-center text-blue-600 underline" %>
