<% content_for :title, "用途を編集" %>

<p class="text-sm">
  <%= link_to "← #{@item.name} の用途", item_purposes_path(@item), class: "text-blue-600 underline" %>
</p>

<h1 class="mt-2 text-2xl font-bold text-slate-900">用途を編集</h1>

<%= render "form", item: @item, purpose: @purpose, submit_label: "保存" %>

<section class="mt-8 rounded-xl border border-red-200 bg-white p-4">
  <h2 class="font-bold text-red-700">この用途を削除</h2>
  <p class="mt-2 text-sm text-slate-600">
    <% if @purpose.used? %>
      <%# 履歴を消さないための守り (docs/spec/01-domain-model.md 3 節) %>
      使用の記録が <%= @purpose.usage_count %> 件あるため削除できません。
      一覧から外すだけなら「アーカイブ」を使ってください。
    <% else %>
      まだ使用の記録がないので削除できます。
    <% end %>
  </p>
  <%= button_to "削除する", item_purpose_path(@item, @purpose), method: :delete,
        disabled: @purpose.used?,
        form: { data: { turbo_confirm: "用途「#{@purpose.name}」を削除します。よろしいですか?" } },
        class: danger_button_classes("mt-3 disabled:cursor-not-allowed disabled:opacity-50") %>
</section>
