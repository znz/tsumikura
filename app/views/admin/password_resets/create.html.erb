<%# Turbo のスナップショットに残すと「戻る」やプレビューでパスワードが再表示される %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<h1 class="text-2xl font-bold text-slate-900">パスワードを再設定しました</h1>
<p class="mt-2 text-sm text-slate-600"><%= @user.name %> (<%= @user.email_address %>)</p>

<%= render "admin/generated_password", heading: "新しいパスワード", password: @generated_password %>

<p class="mt-4 text-sm text-slate-600">ログイン中のデバイスはすべてログアウトしました。</p>
<p class="mt-1 text-sm text-slate-600">この画面を再読み込みすると、別のパスワードが再発行されます。</p>

<%= link_to "ユーザー一覧に戻る", admin_users_path,
      class: "mt-6 inline-flex min-h-11 items-center text-blue-600 underline" %>
