<div class="flex items-center justify-between gap-2">
  <h1 class="text-2xl font-bold text-slate-900">ユーザー管理</h1>
  <%= link_to "ユーザーを追加", new_admin_user_path, class: add_link_classes %>
</div>

<%# 無効化とパスワード再設定は目的が違う (docs/spec/05-auth.md 5 節) %>
<p data-deactivation-note class="mt-4 text-sm text-slate-600">
  <strong>無効化ではパスキーは消えません</strong> (無効化は取り消せるため。無効化中はパスキーでもログインできません)。
  乗っ取りが疑われるときは、パスキーも一緒に消える<strong>パスワードの再設定</strong>を使ってください。
</p>

<ul class="mt-6 space-y-3">
  <% @users.each do |user| %>
    <li class="rounded-xl border border-slate-200 bg-white p-4">
      <div class="flex items-start justify-between gap-2">
        <div class="min-w-0">
          <p class="truncate font-medium text-slate-900"><%= user.name %></p>
          <p class="truncate text-sm text-slate-500"><%= user.email_address %></p>
        </div>
        <div class="flex shrink-0 flex-col items-end gap-1">
          <span class="rounded-full bg-slate-100 px-2 py-1 text-xs text-slate-700"><%= user_role_label(user) %></span>
          <% if user.deactivated? %>
            <span class="rounded-full bg-red-100 px-2 py-1 text-xs text-red-700">無効</span>
          <% end %>
        </div>
      </div>

      <div class="mt-3 flex flex-wrap items-center gap-2">
        <%= link_to "編集", edit_admin_user_path(user), class: secondary_button_classes %>

        <%# 自分自身へのパスワード再設定・無効化は、操作の途中で自分がログアウトするだけなので出さない %>
        <% if user == Current.user %>
          <%= link_to "アカウント設定へ", account_path, class: secondary_button_classes %>
        <% else %>
          <%= link_to "パスワード再設定", new_admin_user_password_reset_path(user), class: secondary_button_classes %>
          <% if user.deactivated? %>
            <%= button_to "再有効化", admin_user_deactivation_path(user), method: :delete, class: secondary_button_classes %>
          <% else %>
            <%= button_to "無効化", admin_user_deactivation_path(user), method: :post,
                  form: { data: { turbo_confirm: "#{user.name} を無効化します。ログインできなくなりますが、登録済みのパスキーは残ります (無効化は取り消せるため)。よろしいですか?" } },
                  class: "min-h-11 rounded-lg border border-red-300 px-3 text-sm text-red-700 hover:bg-red-50" %>
          <% end %>
        <% end %>
      </div>
    </li>
  <% end %>
</ul>
