<div class="flex items-center justify-between gap-2">
  <h1 class="text-2xl font-bold text-slate-900">ユーザー管理</h1>
  <%= link_to "ユーザーを追加", new_admin_user_path,
        class: "flex min-h-11 items-center rounded-lg bg-blue-600 px-4 font-medium text-white hover:bg-blue-500" %>
</div>

<ul class="mt-6 space-y-3">
  <% @users.each do |user| %>
    <li class="rounded-xl border border-slate-200 bg-white p-4">
      <div class="flex items-start justify-between gap-2">
        <div class="min-w-0">
          <p class="truncate font-medium text-slate-900"><%= user.name %></p>
          <p class="truncate text-sm text-slate-500"><%= user.email_address %></p>
        </div>
        <div class="flex shrink-0 flex-col items-end gap-1">
          <span class="rounded-full bg-slate-100 px-2 py-1 text-xs text-slate-700"><%= user_role_label(user) %></span>
          <% if user.deactivated? %>
            <span class="rounded-full bg-red-100 px-2 py-1 text-xs text-red-700">無効</span>
          <% end %>
        </div>
      </div>

      <div class="mt-3 flex flex-wrap items-center gap-2">
        <%= link_to "編集", edit_admin_user_path(user),
              class: "flex min-h-11 items-center rounded-lg border border-slate-300 px-3 text-sm text-slate-700 hover:bg-slate-50" %>

        <%# 自分自身へのパスワード再設定・無効化は、操作の途中で自分がログアウトするだけなので出さない %>
        <% if user == Current.user %>
          <%= link_to "アカウント設定へ", account_path,
                class: "flex min-h-11 items-center rounded-lg border border-slate-300 px-3 text-sm text-slate-700 hover:bg-slate-50" %>
        <% else %>
          <%= link_to "パスワード再設定", new_admin_user_password_reset_path(user),
                class: "flex min-h-11 items-center rounded-lg border border-slate-300 px-3 text-sm text-slate-700 hover:bg-slate-50" %>
          <% if user.deactivated? %>
            <%= button_to "再有効化", admin_user_deactivation_path(user), method: :delete,
                  class: "min-h-11 rounded-lg border border-slate-300 px-3 text-sm text-slate-700 hover:bg-slate-50" %>
          <% else %>
            <%= button_to "無効化", admin_user_deactivation_path(user), method: :post,
                  form: { data: { turbo_confirm: "#{user.name} を無効化します。よろしいですか?" } },
                  class: "min-h-11 rounded-lg border border-red-300 px-3 text-sm text-red-700 hover:bg-red-50" %>
          <% end %>
        <% end %>
      </div>
    </li>
  <% end %>
</ul>
