<%# locals: (user:, submit_label:) %>
<%# 追加はリダイレクトせず初期パスワードを直接表示するため、new のときだけ Turbo のフォーム処理を外す %>
<%= form_with model: [ :admin, user ], class: "mt-6 space-y-5",
      data: (user.new_record? ? { turbo: false } : {}) do |form| %>
  <% if user.errors.any? %>
    <div class="rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800">
      <ul class="list-inside list-disc">
        <% user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "block text-sm font-medium text-slate-700" %>
    <%= form.text_field :name, required: true, autofocus: true,
          class: "mt-2 block min-h-11 w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:outline-blue-600" %>
  </div>

  <div>
    <%= form.label :email_address, class: "block text-sm font-medium text-slate-700" %>
    <%= form.email_field :email_address, required: true, autocomplete: "off",
          class: "mt-2 block min-h-11 w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:outline-blue-600" %>
    <p class="mt-1 text-sm text-slate-500">メールは送りません。ログイン ID として使います。</p>
  </div>

  <div>
    <%= form.label :role, class: "block text-sm font-medium text-slate-700" %>
    <%= form.select :role,
          User.roles.keys.map { |role| [ t("enums.user.role.#{role}"), role ] },
          {},
          class: "mt-2 block min-h-11 w-full rounded-lg border border-slate-300 px-3 py-2 shadow-sm focus:outline-blue-600" %>
  </div>

  <%= form.submit submit_label,
        class: "min-h-11 w-full cursor-pointer rounded-lg bg-blue-600 px-4 py-3 font-medium text-white hover:bg-blue-500" %>
<% end %>

<%= link_to "ユーザー一覧に戻る", admin_users_path, class: "mt-6 inline-flex min-h-11 items-center text-blue-600 underline" %>
