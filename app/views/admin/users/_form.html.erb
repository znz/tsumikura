<%# locals: (user:, submit_label:) %>
<%# 追加はリダイレクトせず初期パスワードを直接表示するため、new のときだけ Turbo のフォーム処理を外す %>
<%= form_with model: [ :admin, user ], class: "mt-6 space-y-5",
      data: (user.new_record? ? { turbo: false } : {}) do |form| %>
  <%= render "form_errors", record: user %>

  <div>
    <%= form.label :name, class: label_classes %>
    <%= form.text_field :name, required: true, autofocus: true, class: field_classes %>
  </div>

  <div>
    <%= form.label :email_address, class: label_classes %>
    <%= form.email_field :email_address, required: true, autocomplete: "off", class: field_classes %>
    <p class="<%= hint_classes %>">メールは送りません。ログイン ID として使います。</p>
  </div>

  <div>
    <%= form.label :role, class: label_classes %>
    <%= form.select :role,
          User.roles.keys.map { |role| [ t("enums.user.role.#{role}"), role ] },
          {}, class: field_classes %>
  </div>

  <%= form.submit submit_label, class: primary_button_classes %>
<% end %>

<%= link_to "ユーザー一覧に戻る", admin_users_path, class: "mt-6 inline-flex min-h-11 items-center text-blue-600 underline" %>
