<%# locals: (record:) %>
<% if record.errors.any? %>
  <div class="rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
    <ul class="list-inside list-disc">
      <% record.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
