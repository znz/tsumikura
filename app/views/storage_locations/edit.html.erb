<% content_for :title, "保管場所を編集" %>

<h1 class="text-2xl font-bold text-slate-900">保管場所を編集</h1>

<%= render "form", storage_location: @storage_location, submit_label: "保存" %>

<%# 削除は nullify。確認ダイアログ (JS) だけに頼らず、外れる件数をサーバ側で出す %>
<section class="mt-8 rounded-xl border border-red-200 bg-white p-4">
  <h2 class="font-bold text-red-700">この保管場所を削除</h2>
  <p class="mt-2 text-sm text-slate-600">
    削除すると <%= @storage_location.items.count %> 件の品目から保管場所が外れます。品目は消えません。
  </p>
  <%= button_to "削除する", storage_location_path(@storage_location), method: :delete,
        form: { data: { turbo_confirm: "保管場所「#{@storage_location.name}」を削除します。よろしいですか?" } },
        class: danger_button_classes("mt-3") %>
</section>

<%= link_to "保管場所一覧に戻る", storage_locations_path, class: "mt-6 inline-flex min-h-11 items-center text-blue-600 underline" %>
