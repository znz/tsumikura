<% content_for :title, "保管場所" %>

<div class="flex items-center justify-between gap-2">
  <h1 class="text-2xl font-bold text-slate-900">保管場所</h1>
  <%= link_to "保管場所を追加", new_storage_location_path,
        class: "flex min-h-11 items-center rounded-lg bg-blue-600 px-4 font-medium text-white hover:bg-blue-500" %>
</div>

<p class="mt-2 text-sm text-slate-600">棚卸のときに選ぶ場所です。並び順は「上へ / 下へ」で変えられます。</p>

<% if @storage_locations.empty? %>
  <p class="mt-6 rounded-xl border border-slate-200 bg-white p-6 text-center text-sm text-slate-600">
    まだ保管場所がありません。
  </p>
<% else %>
  <ul class="mt-6 space-y-3" aria-label="保管場所一覧">
    <% @storage_locations.each_with_index do |storage_location, index| %>
      <li class="rounded-xl border border-slate-200 bg-white p-4">
        <div class="flex items-start justify-between gap-2">
          <div class="min-w-0">
            <p class="truncate font-medium text-slate-900"><%= storage_location.name %></p>
            <p class="text-sm text-slate-500">品目 <%= @item_counts.fetch(storage_location.id, 0) %> 件</p>
          </div>
          <%= link_to "編集", edit_storage_location_path(storage_location), class: secondary_button_classes("shrink-0") %>
        </div>

        <div class="mt-3 flex items-center gap-2">
          <%# 行が増えてもボタン名が区別できるよう、アクセシブルネームに名前を入れる %>
          <%= button_to "上へ", storage_location_position_path(storage_location), method: :patch,
                params: { direction: "up" }, disabled: index.zero?,
                aria: { label: "「#{storage_location.name}」を上へ" },
                class: secondary_button_classes("disabled:opacity-40") %>
          <%= button_to "下へ", storage_location_position_path(storage_location), method: :patch,
                params: { direction: "down" }, disabled: index == @storage_locations.size - 1,
                aria: { label: "「#{storage_location.name}」を下へ" },
                class: secondary_button_classes("disabled:opacity-40") %>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>

<%= link_to "メニューに戻る", menu_path, class: "mt-6 inline-flex min-h-11 items-center text-blue-600 underline" %>
