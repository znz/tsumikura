<%# locals: (lot:, item:, today: nil) %>
<%#
  ロット 1 行。期限は「期限を管理する」品目でなくても、入っていれば必ず出す。
  tracks_expiry は入力 UI の出し分けだけで、期限切れの判定 (在庫 q からの除外・バッジ) は
  expires_on の有無で行う (docs/spec/02-forecast.md 12 節)。出さないと、あとから
  「期限を管理する」を外した品目で、見えない期限のせいで期限切れ扱いになる。
  today はコントローラが 1 リクエストにつき 1 回だけ取ったもの (0 時をまたいでずれないように)。
%>
<% today ||= Date.current %>
<li class="flex items-start justify-between gap-3 py-3">
  <div class="min-w-0">
    <p class="font-medium text-slate-900">
      残り <%= lot.remaining_quantity %> <%= item.unit %>
      <span class="text-sm font-normal text-slate-500">/ <%= lot.initial_quantity %> <%= item.unit %></span>
      <% unless lot.kind_purchase? %>
        <span class="ml-1 rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-600">
          <%= lot_kind_label(lot) %>
        </span>
      <% end %>
    </p>
    <p class="mt-1 text-sm text-slate-500">
      <% if item.tracks_expiry? || lot.expires_on.present? %>
        期限: <%= lot.expires_on ? l(lot.expires_on) : "なし" %>
        <% if lot.expired?(today) %>
          <span class="rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium text-red-700">期限切れ</span>
        <% end %>
        ・
      <% end %>
      購入日: <%= l(lot.acquired_on) %>
    </p>
    <p class="mt-1 text-sm text-slate-500">
      <%= lot.store&.name || "店舗の記録なし" %>
      <% if lot.unit_price_yen %>
        ・ <%= unit_price_text(lot.unit_price_yen, item.unit) %>
      <% end %>
    </p>
    <% if lot.note.present? %>
      <p class="mt-1 text-sm text-slate-500"><%= lot.note %></p>
    <% end %>
  </div>
  <div class="flex shrink-0 items-center gap-2">
    <%# 期限切れロットからは廃棄に進めるようにする (docs/spec/02-forecast.md 12 節) %>
    <% if lot.expired?(today) && lot.remaining_quantity.positive? %>
      <%= link_to "廃棄", new_item_disposal_path(item, lot_id: lot.id),
            aria: { label: "このロットを廃棄" }, class: secondary_button_classes("text-red-700") %>
    <% end %>
    <%# 調整ロットは画面から編集できない (元になった使用記録・棚卸の側から直す) %>
    <% if lot.recordable? %>
      <%= link_to "編集", edit_lot_path(lot), class: secondary_button_classes %>
    <% end %>
  </div>
</li>
