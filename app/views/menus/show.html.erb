<h1 class="text-2xl font-bold text-slate-900">メニュー</h1>

<h2 class="mt-6 text-sm font-medium text-slate-500">記録</h2>

<ul class="mt-2 divide-y divide-slate-200 overflow-hidden rounded-xl border border-slate-200 bg-white">
  <li>
    <%= link_to "棚卸", stock_takes_path,
          class: "flex min-h-14 items-center px-4 py-3 text-slate-900 hover:bg-slate-50" %>
  </li>
</ul>

<h2 class="mt-6 text-sm font-medium text-slate-500">マスタ管理</h2>

<ul class="mt-2 divide-y divide-slate-200 overflow-hidden rounded-xl border border-slate-200 bg-white">
  <li>
    <%= link_to "カテゴリ", categories_path,
          class: "flex min-h-14 items-center px-4 py-3 text-slate-900 hover:bg-slate-50" %>
  </li>
  <li>
    <%= link_to "保管場所", storage_locations_path,
          class: "flex min-h-14 items-center px-4 py-3 text-slate-900 hover:bg-slate-50" %>
  </li>
  <li>
    <%= link_to "店舗", stores_path,
          class: "flex min-h-14 items-center px-4 py-3 text-slate-900 hover:bg-slate-50" %>
  </li>
</ul>

<h2 class="mt-6 text-sm font-medium text-slate-500">アカウント</h2>

<ul class="mt-2 divide-y divide-slate-200 overflow-hidden rounded-xl border border-slate-200 bg-white">
  <li>
    <%= link_to "アカウント設定", account_path,
          class: "flex min-h-14 items-center px-4 py-3 text-slate-900 hover:bg-slate-50" %>
  </li>

  <% if Current.user.admin? %>
    <li>
      <%= link_to "ユーザー管理", admin_users_path,
            class: "flex min-h-14 items-center px-4 py-3 text-slate-900 hover:bg-slate-50" %>
    </li>
  <% end %>

  <li>
    <%# ログアウトでこの端末の Web Push の購読も解除する (docs/spec/04-notifications.md 5 節)。
        JS が無い / 解除できないときは push_endpoint が空のまま送られ、ふつうにログアウトする %>
    <%= form_with url: session_path, method: :delete,
          data: { controller: "logout", action: "submit->logout#submit" } do |form| %>
      <%= form.hidden_field :push_endpoint, value: "", data: { logout_target: "endpoint" } %>
      <%= form.button "ログアウト",
            class: "flex min-h-14 w-full items-center px-4 py-3 text-left text-red-600 hover:bg-slate-50" %>
    <% end %>
  </li>
</ul>

<p class="mt-6 text-sm text-slate-500">履歴は順次追加します。</p>
