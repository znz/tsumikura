<h1 class="text-2xl font-bold text-slate-900">アカウント設定</h1>

<section class="mt-6 rounded-xl border border-slate-200 bg-white p-4">
  <h2 class="font-bold text-slate-900">表示名とメールアドレス</h2>

  <%= form_with model: @user, url: account_path, method: :patch, class: "mt-4 space-y-5" do |form| %>
    <%= render "form_errors", record: @user %>

    <div>
      <%= form.label :name, class: label_classes %>
      <%= form.text_field :name, required: true, class: field_classes %>
    </div>

    <div>
      <%= form.label :email_address, class: label_classes %>
      <%= form.email_field :email_address, required: true, autocomplete: "username", class: field_classes %>
    </div>

    <%= form.submit "保存", class: primary_button_classes %>
  <% end %>
</section>

<section class="mt-6 rounded-xl border border-slate-200 bg-white p-4">
  <h2 class="font-bold text-slate-900">パスワードの変更</h2>

  <%= form_with url: account_password_path, method: :patch, class: "mt-4 space-y-5" do |form| %>
    <div>
      <%= form.label :current_password, "現在のパスワード", class: label_classes %>
      <%= form.password_field :current_password, required: true, autocomplete: "current-password", maxlength: 72,
            class: field_classes %>
    </div>

    <div>
      <%= form.label :password, "新しいパスワード", class: label_classes %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72,
            class: field_classes %>
      <p class="<%= hint_classes %>"><%= User::MINIMUM_PASSWORD_LENGTH %> 文字以上</p>
    </div>

    <div>
      <%= form.label :password_confirmation, "新しいパスワード (確認)", class: label_classes %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72,
            class: field_classes %>
    </div>

    <%= form.submit "パスワードを変更", class: primary_button_classes %>
  <% end %>
</section>

<section class="mt-6 rounded-xl border border-slate-200 bg-white p-4">
  <h2 class="font-bold text-slate-900">パスキー</h2>
  <p class="<%= hint_classes %>">
    顔・指紋・画面ロックでログインできるようにします。パスワードは引き続き使えます
    (パスキーを 1 つも登録しなくてもかまいません)。
  </p>

  <h3 class="mt-4 font-bold text-slate-900">登録済みのパスキー</h3>

  <% if @passkeys.any? %>
    <ul class="mt-2 divide-y divide-slate-200" aria-label="登録済みのパスキー">
      <% @passkeys.each do |passkey| %>
        <li class="flex items-center justify-between gap-2 py-3">
          <div class="min-w-0">
            <p class="truncate text-sm text-slate-900"><%= passkey.nickname %></p>
            <p class="truncate text-sm text-slate-500">
              <%= l passkey.created_at %> 登録 /
              <% if passkey.last_used_at %>
                最終利用 <%= l passkey.last_used_at %>
              <% else %>
                未使用
              <% end %>
            </p>
          </div>

          <%= button_to "削除", passkey_path(passkey), method: :delete,
                form: { data: { turbo_confirm: "#{passkey.nickname} を削除します。この端末ではパスキーでログインできなくなります。" } },
                class: secondary_button_classes("shrink-0") %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="<%= hint_classes %>">まだ登録されていません。</p>
  <% end %>

  <% if Passkey.available? %>
    <%# 登録は navigator.credentials.create が要るので JS でだけ出す。
        **現在のパスワードの再確認**を求める (セッションを盗んだ者が自分のパスキーを
        足して居座れないようにする。docs/spec/05-auth.md 5 節) %>
    <div class="mt-5" data-controller="passkey"
         data-passkey-url-value="<%= passkeys_path %>"
         data-passkey-options-url-value="<%= options_passkeys_path %>">
      <form hidden data-passkey-target="form" data-action="submit->passkey#register" class="space-y-5">
        <h3 class="font-bold text-slate-900">この端末を登録</h3>

        <div>
          <%# ラベルは /account の他のフォーム (パスワード変更) と**部分一致でもぶつからない**語にする
              (Capybara の fill_in は既定で部分一致なので、system spec が曖昧になる) %>
          <label for="passkey_nickname" class="<%= label_classes %>">パスキーの名前 (任意)</label>
          <input type="text" id="passkey_nickname" name="nickname" maxlength="<%= Passkey::MAX_NICKNAME_LENGTH %>"
                 placeholder="太郎のiPhone" autocomplete="off"
                 data-passkey-target="nickname" class="<%= field_classes %>">
          <p class="<%= hint_classes %>">空のままなら、この端末の名前 (iPhone / Safari など) を付けます。</p>
        </div>

        <div>
          <label for="passkey_current_password" class="<%= label_classes %>">本人確認のパスワード</label>
          <input type="password" id="passkey_current_password" maxlength="72"
                 autocomplete="current-password"
                 data-passkey-target="password" class="<%= field_classes %>">
          <p class="<%= hint_classes %>">いま使っているパスワードを入れてください (登録するときだけ)。</p>
        </div>

        <button type="submit" data-passkey-target="submit" class="<%= primary_button_classes %>">
          この端末にパスキーを登録
        </button>
      </form>

      <p data-passkey-target="status" role="status" class="mt-2 text-sm text-slate-700"></p>

      <p hidden data-passkey-target="unsupported" class="mt-3 text-sm text-slate-500">
        このブラウザはパスキーに対応していません。
      </p>
    </div>
  <% else %>
    <p data-webauthn-missing class="mt-4 rounded-lg bg-amber-50 p-3 text-sm text-amber-900">
      サーバにパスキーの設定 (WEBAUTHN_ORIGIN) がありません。管理者が設定すると使えるようになります。
    </p>
  <% end %>
</section>

<section class="mt-6 rounded-xl border border-slate-200 bg-white p-4">
  <h2 class="font-bold text-slate-900">通知</h2>
  <p class="<%= hint_classes %>">
    要購入・期限の状態が前より悪くなった品目があるときだけ、毎朝 <%= digest_hour %> 時ごろに 1 通だけお知らせします。
  </p>

  <% if Vapid.configured? %>
    <%# 購読は端末ごと。ボタンは JS が状態を見てから出す (JS 無しでは何も出ない) %>
    <div class="mt-4" data-controller="push-subscription"
         data-push-subscription-url-value="<%= web_push_subscriptions_path %>"
         data-push-subscription-public-key-value="<%= Vapid.public_key %>">
      <p data-push-subscription-target="status" role="status" class="text-sm text-slate-700"></p>

      <button type="button" hidden
              data-push-subscription-target="subscribe"
              data-action="push-subscription#subscribe"
              class="<%= primary_button_classes("mt-3") %>">この端末で通知を受け取る</button>

      <button type="button" hidden
              data-push-subscription-target="unsubscribe"
              data-action="push-subscription#unsubscribe"
              class="<%= danger_button_classes("mt-3") %>">この端末の通知をオフにする</button>

      <p hidden data-push-subscription-target="unsupported" class="mt-3 text-sm text-slate-500">
        このブラウザは Web Push に対応していません。
      </p>

      <%# iOS はホーム画面に追加するまで通知を許可できない (ブラウザ側の制約) %>
      <p hidden data-push-subscription-target="ios" class="mt-3 rounded-lg bg-slate-50 p-3 text-sm text-slate-700">
        iPhone・iPad では、共有メニューから<strong>「ホーム画面に追加」</strong>して、
        追加されたアイコンから開いたあとに通知をオンにしてください。
      </p>

      <%# ログアウトでこの端末の購読を消す (docs/spec/04-notifications.md 5 節)。
          気づかないと「オンにしたのに届かない」になるので先に断っておく %>
      <p class="<%= hint_classes %>">ログアウトすると、この端末の通知はオフになります。</p>
    </div>

    <%= button_to "テスト送信", notification_test_path, class: secondary_button_classes("mt-3 w-full") %>
  <% else %>
    <p data-vapid-missing class="mt-4 rounded-lg bg-amber-50 p-3 text-sm text-amber-900">
      サーバに通知の鍵が設定されていません。管理者が VAPID の鍵を設定すると使えるようになります。
    </p>
  <% end %>

  <%# 知らせる種別は端末の購読とは別の軸。JS 無しで動くふつうのフォームにする %>
  <%= form_with model: @user, url: account_notification_setting_path, method: :patch, class: "mt-5" do |form| %>
    <fieldset>
      <legend class="text-sm font-medium text-slate-700">知らせてほしいこと</legend>

      <label class="mt-1 flex min-h-11 items-center gap-2">
        <%= form.check_box :notify_purchases, class: "size-5 rounded border-slate-300" %>
        <span class="text-sm text-slate-900">購入のお知らせ (そろそろ購入・購入推奨)</span>
      </label>

      <label class="flex min-h-11 items-center gap-2">
        <%= form.check_box :notify_expiries, class: "size-5 rounded border-slate-300" %>
        <span class="text-sm text-slate-900">期限のお知らせ (期限間近・期限切れ)</span>
      </label>
    </fieldset>

    <%= form.submit "通知の設定を保存", class: primary_button_classes("mt-3") %>
  <% end %>

  <h3 class="mt-6 font-bold text-slate-900">通知を受け取る端末</h3>

  <% if @push_subscriptions.any? %>
    <ul class="mt-2 divide-y divide-slate-200" aria-label="通知を受け取る端末">
      <% @push_subscriptions.each do |subscription| %>
        <li class="flex items-center justify-between gap-2 py-3">
          <div class="min-w-0">
            <%# endpoint は端末を特定できる値なので画面には出さない %>
            <p class="truncate text-sm text-slate-900"><%= push_device_label(subscription.user_agent) %></p>
            <p class="truncate text-sm text-slate-500">
              <% if subscription.last_delivered_at %>
                最終配信 <%= l subscription.last_delivered_at %>
              <% else %>
                まだ配信していません
              <% end %>
            </p>
          </div>

          <%= button_to "削除", web_push_subscription_path(subscription), method: :delete,
                class: secondary_button_classes("shrink-0") %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="<%= hint_classes %>">まだ登録されていません。</p>
  <% end %>
</section>

<section class="mt-6 rounded-xl border border-slate-200 bg-white p-4">
  <h2 class="font-bold text-slate-900">ログイン中のデバイス</h2>

  <ul class="mt-4 divide-y divide-slate-200">
    <% @sessions.each do |login_session| %>
      <li class="flex items-center justify-between gap-2 py-3">
        <div class="min-w-0">
          <p class="truncate text-sm text-slate-900">
            <%= login_session.user_agent.presence || "不明なブラウザ" %>
            <% if login_session == Current.session %>
              <span data-current-session class="ml-1 rounded-full bg-blue-100 px-2 py-0.5 text-xs text-blue-700">このデバイス</span>
            <% end %>
          </p>
          <p class="truncate text-sm text-slate-500">
            <%= login_session.ip_address.presence || "IP 不明" %> / <%= l login_session.created_at %>
          </p>
        </div>

        <%= button_to "ログアウト", account_session_path(login_session), method: :delete,
              class: secondary_button_classes("shrink-0") %>
      </li>
    <% end %>
  </ul>

  <%= button_to "このデバイス以外をすべてログアウト", others_account_sessions_path, method: :delete,
        class: danger_button_classes("mt-4") %>
</section>
