<%#
  下部固定の 5 タブ (docs/spec/03-screens.md 1 節)。
  中央の「＋記録」はアクションシート (JS が要る) ではなく記録メニューのページに送る。
  「買い物」に要購入の件数バッジは付けない。数えるには毎ページで
  Forecast::BatchForecaster を走らせることになり、全画面のクエリが増えるため
  (docs/spec/03-screens.md 1 節)。
%>
<% item_class = "flex min-h-14 w-full flex-col items-center justify-center gap-0.5 px-1 py-2 text-xs font-medium" %>
<nav class="fixed inset-x-0 bottom-0 z-10 border-t border-slate-200 bg-white pb-[env(safe-area-inset-bottom)]"
     aria-label="グローバルナビ">
  <ul class="mx-auto flex max-w-2xl items-stretch">
    <li class="flex-1">
      <%= link_to root_path,
            class: "#{item_class} #{current_page?(root_path) ? 'text-blue-600' : 'text-slate-600'}",
            aria: { current: ("page" if current_page?(root_path)) } do %>
        ホーム
      <% end %>
    </li>

    <li class="flex-1">
      <%# 詳細 (/items/1) や追加フォーム (/items/new)、アーカイブ操作でもハイライトする %>
      <%= link_to items_path,
            class: "#{item_class} #{items_tab_current? ? 'text-blue-600' : 'text-slate-600'}",
            aria: { current: ("page" if items_tab_current?) } do %>
        品目
      <% end %>
    </li>

    <li class="flex-1">
      <%= link_to record_menu_path,
            class: "flex min-h-14 w-full flex-col items-center justify-center py-2",
            aria: { current: ("page" if record_tab_current?) } do %>
        <span class="flex size-11 items-center justify-center rounded-full bg-blue-600 text-2xl leading-none text-white" aria-hidden="true">＋</span>
        <span class="mt-0.5 text-xs font-medium <%= record_tab_current? ? 'text-blue-600' : 'text-slate-600' %>">記録</span>
      <% end %>
    </li>

    <li class="flex-1">
      <%# 買い物リストとまとめ購入でハイライトする %>
      <%= link_to shopping_list_path,
            class: "#{item_class} #{shopping_tab_current? ? 'text-blue-600' : 'text-slate-600'}",
            aria: { current: ("page" if shopping_tab_current?) } do %>
        買い物
      <% end %>
    </li>

    <li class="flex-1">
      <%= link_to menu_path,
            class: "#{item_class} #{current_page?(menu_path) ? 'text-blue-600' : 'text-slate-600'}",
            aria: { current: ("page" if current_page?(menu_path)) } do %>
        メニュー
      <% end %>
    </li>
  </ul>
</nav>
