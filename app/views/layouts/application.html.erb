<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= content_for(:title) || "つみくら" %></title>
    <%# viewport-fit=cover: 下部固定タブが env(safe-area-inset-bottom) を使えるようにする %>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="つみくら">
    <meta name="application-name" content="つみくら">
    <meta name="mobile-web-app-capable" content="yes">
    <%# manifest の theme_color と同じ値。アドレスバーと iOS のステータスバーの色 %>
    <meta name="theme-color" content="#5B7C5A">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# VAPID の公開鍵は全ページには置かない。使うのはアカウント設定の通知セクションだけなので、
        そこの data-push-subscription-public-key-value に持たせる
        (docs/spec/04-notifications.md 3 節) %>

    <%= yield :head %>

    <%# ホーム画面に追加できるようにする (config/routes.rb の PWA の 2 行とセット) %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%# iOS は角を自分で丸めるので、角丸の icon.png ではなく全面塗りの 180px を渡す
        (script/generate_icons.sh が icon.svg から作る) %>
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%# app/assets 以下の CSS をまとめて読み込む (Tailwind のビルド成果物 app/assets/builds/tailwind.css を含む) %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-slate-50 text-slate-900">
    <%= render "layouts/flash" %>

    <%# 下部タブ (約 3.5rem) + ホームインジケータの分だけ本文の下を空ける %>
    <main class="mx-auto w-full max-w-2xl px-4 py-6 <%= "pb-[calc(7rem+env(safe-area-inset-bottom))]" if Current.user %>">
      <%= yield %>
    </main>

    <%# 未ログイン (ログイン画面) にはタブを出さない %>
    <%= render "layouts/tab_bar" if Current.user %>

    <%#
      トーストの置き場所 (docs/spec/03-screens.md 画面 4b)。
      ワンタップ使用は Turbo Stream でここに append し、JS が無いときは
      リダイレクト後に flash[:toast] から描く。どちらでも同じ部分テンプレートを使う。
    %>
    <%# 読み上げは常設のこの器で拾う (トースト自体は後から差し込まれるため) %>
    <div id="toasts" role="status" aria-live="polite"
         class="pointer-events-none fixed inset-x-0 bottom-0 z-20 mx-auto flex w-full max-w-2xl flex-col gap-2 px-4 pb-[calc(4.5rem+env(safe-area-inset-bottom))]">
      <% if flash[:toast].present? %>
        <%= render "layouts/toast", message: flash[:toast], undo_path: flash[:undo_path] %>
      <% end %>
    </div>
  </body>
</html>
