<%# locals: (store:, submit_label:) %>
<%= form_with model: store, class: "mt-6 space-y-5" do |form| %>
  <%= render "form_errors", record: store %>

  <div>
    <%= form.label :name, class: label_classes %>
    <%= form.text_field :name, required: true, autofocus: true, class: field_classes %>
  </div>

  <div>
    <%= form.label :note, class: label_classes %>
    <%= form.text_area :note, rows: 3, class: field_classes %>
  </div>

  <%= form.submit submit_label, class: primary_button_classes %>
<% end %>
