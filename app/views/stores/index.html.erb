<% content_for :title, "店舗" %>

<div class="flex items-center justify-between gap-2">
  <h1 class="text-2xl font-bold text-slate-900">店舗</h1>
  <%= link_to "店舗を追加", new_store_path,
        class: "flex min-h-11 items-center rounded-lg bg-blue-600 px-4 font-medium text-white hover:bg-blue-500" %>
</div>

<p class="mt-2 text-sm text-slate-600">購入を記録するときに選びます。名前順に並びます。</p>

<% if @stores.empty? %>
  <p class="mt-6 rounded-xl border border-slate-200 bg-white p-6 text-center text-sm text-slate-600">
    まだ店舗がありません。
  </p>
<% else %>
  <ul class="mt-6 space-y-3" aria-label="店舗一覧">
    <% @stores.each do |store| %>
      <li class="rounded-xl border border-slate-200 bg-white p-4">
        <div class="flex items-start justify-between gap-2">
          <div class="min-w-0">
            <p class="truncate font-medium text-slate-900"><%= store.name %></p>
            <% if store.note.present? %>
              <p class="whitespace-pre-line text-sm text-slate-500"><%= store.note %></p>
            <% end %>
          </div>
          <%= link_to "編集", edit_store_path(store), class: secondary_button_classes("shrink-0") %>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>

<%= link_to "メニューに戻る", menu_path, class: "mt-6 inline-flex min-h-11 items-center text-blue-600 underline" %>
