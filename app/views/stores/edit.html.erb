<% content_for :title, "店舗を編集" %>

<h1 class="text-2xl font-bold text-slate-900">店舗を編集</h1>

<%= render "form", store: @store, submit_label: "保存" %>

<%# 削除は nullify。確認ダイアログ (JS) だけに頼らず、外れる件数をサーバ側で出す %>
<section class="mt-8 rounded-xl border border-red-200 bg-white p-4">
  <h2 class="font-bold text-red-700">この店舗を削除</h2>
  <p class="mt-2 text-sm text-slate-600">
    削除すると <%= @store.lots.count %> 件の購入の記録から店舗が外れます。記録は消えません。
  </p>
  <%= button_to "削除する", store_path(@store), method: :delete,
        form: { data: { turbo_confirm: "店舗「#{@store.name}」を削除します。よろしいですか?" } },
        class: danger_button_classes("mt-3") %>
</section>

<%= link_to "店舗一覧に戻る", stores_path, class: "mt-6 inline-flex min-h-11 items-center text-blue-600 underline" %>
