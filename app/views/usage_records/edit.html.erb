<% content_for :title, "使用の記録を編集" %>

<p class="text-sm">
  <%= link_to "← #{@item.name}", item_path(@item), class: "text-blue-600 underline" %>
</p>

<h1 class="mt-2 text-2xl font-bold text-slate-900">使用の記録を編集</h1>
<%# 検証エラーで再描画するときは入力途中の値が入っているので、保存済みの値を出す
    (空や不正な日付が入っていると l() が I18n::ArgumentError で 500 になる) %>
<p class="<%= hint_classes %>">
  <%= l(@usage_record.used_on_in_database) %> に記録した
  <%= @usage_record.quantity_in_database %> <%= @item.unit %>。
  数量・日付を直すと、引き当てるロットも取り直します。
</p>

<%= render "form", item: @item, usage_record: @usage_record, purposes: @purposes, lots: @lots,
      submit_label: "保存" %>

<section class="mt-8 rounded-xl border border-red-200 bg-white p-4">
  <h2 class="font-bold text-red-700">この記録を削除</h2>
  <p class="mt-2 text-sm text-slate-600">
    削除すると在庫が <%= @usage_record.quantity_in_database %> <%= @item.unit %> 戻ります。
  </p>
  <%= button_to "削除する", usage_record_path(@usage_record), method: :delete,
        form: { data: { turbo_confirm: "この使用の記録を削除します。よろしいですか?" } },
        class: danger_button_classes("mt-3") %>
</section>
