<% content_for :title, "品目" %>

<div class="flex items-center justify-between gap-2">
  <h1 class="text-2xl font-bold text-slate-900">品目</h1>
  <%= link_to "品目を追加", new_item_path,
        class: "flex min-h-11 items-center rounded-lg bg-blue-600 px-4 font-medium text-white hover:bg-blue-500" %>
</div>

<%# 絞り込みは GET。JS 無しで動くよう「絞り込む」ボタンで送信する %>
<%= form_with url: items_path, method: :get, class: "mt-4 space-y-3 rounded-xl border border-slate-200 bg-white p-4" do |form| %>
  <div>
    <%= form.label :q, "検索", class: label_classes %>
    <%= form.search_field :q, value: @query, placeholder: "名前・よみ", class: field_classes %>
  </div>

  <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
    <div>
      <%= form.label :category_id, "カテゴリ", class: label_classes %>
      <%= form.select :category_id,
            options_from_collection_for_select(@categories, :id, :name, @category_id),
            { include_blank: "すべて" }, class: field_classes %>
    </div>

    <div>
      <%= form.label :storage_location_id, "保管場所", class: label_classes %>
      <%= form.select :storage_location_id,
            options_from_collection_for_select(@storage_locations, :id, :name, @storage_location_id),
            { include_blank: "すべて" }, class: field_classes %>
    </div>

    <div>
      <%= form.label :status, "状態", class: label_classes %>
      <%= form.select :status,
            options_for_select([ [ "有効な品目", "active" ], [ "アーカイブ済み", "archived" ], [ "すべて", "all" ] ], @status),
            {}, class: field_classes %>
    </div>
  </div>

  <%= form.submit "絞り込む", class: primary_button_classes %>
<% end %>

<% if @items.empty? %>
  <p class="mt-6 rounded-xl border border-slate-200 bg-white p-6 text-center text-sm text-slate-600">
    条件に合う品目が見つかりません。
  </p>
<% else %>
  <ul class="mt-6 divide-y divide-slate-200 overflow-hidden rounded-xl border border-slate-200 bg-white"
      aria-label="品目一覧">
    <% @items.each do |item| %>
      <li>
        <%= link_to item_path(item), class: "flex min-h-14 items-center justify-between gap-3 px-4 py-3 hover:bg-slate-50" do %>
          <span class="min-w-0">
            <span class="block truncate font-medium text-slate-900">
              <%= item.name %>
              <% if item.favorite? %>
                <span class="text-amber-500" role="img" aria-label="お気に入り">★</span>
              <% end %>
            </span>
            <span class="block truncate text-sm text-slate-500">
              <%= [ item.category&.name, item.storage_location&.name ].compact_blank.join(" / ").presence || "分類なし" %>
              <% if item.archived? %>
                <span class="ml-1 rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-600">アーカイブ済み</span>
              <% end %>
            </span>
          </span>
          <span class="shrink-0 text-right">
            <span class="block text-lg font-bold text-slate-900"><%= item.current_quantity %></span>
            <span class="block text-xs text-slate-500"><%= item.unit %></span>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
