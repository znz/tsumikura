<%#
  ワンタップ使用の応答 (docs/spec/03-screens.md 画面 4b)。
  一覧の行・ダッシュボードのタイル・品目詳細の本文をまとめて差し替え、トーストを足す。
  Turbo は画面に無い id を黙って無視するので、どの画面から押しても同じ応答で足りる。
  行とタイルはステータスバッジを含むので、記録した直後に判定も更新される。
%>
<%= turbo_stream.replace dom_id(@item) do %>
  <%= render "items/item", item: @item, forecast: @forecast, expiry: @expiry %>
<% end %>

<%= turbo_stream.replace dom_id(@item, :quick_use) do %>
  <%= render "dashboards/quick_use_item", item: @item, forecast: @forecast, expiry: @expiry %>
<% end %>

<%#
  アラートカードと最近の記録はダッシュボード全体の集計なので、この品目だけでは出せない。
  ダッシュボードから押されたときだけ集計し直して差し替える
  (でないと「タイルは購入推奨なのにカードは 0 件」がリロードまで残る)。
%>
<% if @from_dashboard %>
  <%= turbo_stream.replace "alerts" do %>
    <%= render "dashboards/alerts" %>
  <% end %>

  <%= turbo_stream.replace "recent_records" do %>
    <%= render "dashboards/recent_records" %>
  <% end %>
<% end %>

<%# 詳細は入れ物の div を残したいので update (replace だと差し替え先の id ごと消える) %>
<%= turbo_stream.update dom_id(@item, :detail) do %>
  <%= render "items/detail" %>
<% end %>

<%= turbo_stream.append "toasts" do %>
  <%= render "layouts/toast", message: @toast_message, undo_path: @undo_path %>
<% end %>
