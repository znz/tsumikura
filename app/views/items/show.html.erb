<% content_for :title, @item.name %>

<p class="text-sm">
  <%= link_to "← 品目一覧", items_path, class: "text-blue-600 underline" %>
</p>

<div class="mt-2 flex items-start justify-between gap-2">
  <div class="min-w-0">
    <h1 class="text-2xl font-bold text-slate-900">
      <%= @item.name %>
      <% if @item.favorite? %>
        <span class="text-amber-500" role="img" aria-label="お気に入り">★</span>
      <% end %>
    </h1>
    <% if @item.name_reading.present? %>
      <p class="text-sm text-slate-500"><%= @item.name_reading %></p>
    <% end %>
  </div>
  <%= link_to "編集", edit_item_path(@item), class: secondary_button_classes("shrink-0") %>
</div>

<% if @item.archived? %>
  <div class="mt-4 rounded-xl border border-slate-300 bg-slate-100 p-4">
    <p class="text-sm font-medium text-slate-700">この品目はアーカイブ済みです。一覧には出ません。</p>
    <%= button_to "アーカイブを解除", item_archive_path(@item), method: :delete,
          class: secondary_button_classes("mt-3 w-full") %>
  </div>
<% end %>

<section class="mt-4 rounded-xl border border-slate-200 bg-white p-4" aria-label="在庫">
  <p class="text-sm text-slate-500">在庫数</p>
  <p class="mt-1">
    <span class="text-4xl font-bold text-slate-900"><%= @item.current_quantity %></span>
    <span class="ml-1 text-lg text-slate-600"><%= @item.unit %></span>
  </p>
  <% if @item.minimum_quantity.present? %>
    <p class="<%= hint_classes %>">最低在庫数: <%= @item.minimum_quantity %> <%= @item.unit %></p>
  <% end %>

  <%= link_to "購入を記録", new_item_lot_path(@item),
        class: primary_button_classes("mt-4 block text-center") %>
</section>

<%# ロットは期限が近い順 (FEFO)。使い切ったロットは畳んでおく (docs/spec/01-domain-model.md 判断 2) %>
<section class="mt-4 rounded-xl border border-slate-200 bg-white p-4" aria-label="ロット">
  <h2 class="font-bold text-slate-900">ロット</h2>
  <% if @average_unit_price_yen %>
    <p class="<%= hint_classes %>">
      最近の単価: 平均 <%= unit_price_text(@average_unit_price_yen, @item.unit) %>
      <span class="text-slate-400">(価格を記録した直近 <%= Lot::RECENT_PRICED_LOTS %> 件)</span>
    </p>
  <% end %>

  <% if @available_lots.any? %>
    <ul class="mt-3 divide-y divide-slate-200" aria-label="ロット一覧">
      <% @available_lots.each do |lot| %>
        <%= render "lots/lot", lot: lot, item: @item %>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-3 text-sm text-slate-600">在庫のあるロットはまだありません。</p>
  <% end %>

  <% if @depleted_lots.any? %>
    <details class="group mt-3 border-t border-slate-200 pt-3">
      <summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 py-2 text-sm font-medium text-slate-700">
        <span class="text-slate-400 transition-transform group-open:rotate-90" aria-hidden="true">▶</span>
        <span>使い切ったロット (<%= @depleted_lots_count %> 件)</span>
      </summary>
      <ul class="divide-y divide-slate-200" aria-label="使い切ったロット一覧">
        <% @depleted_lots.each do |lot| %>
          <%= render "lots/lot", lot: lot, item: @item %>
        <% end %>
      </ul>
      <% if @depleted_lots_count > @depleted_lots.size %>
        <p class="<%= hint_classes %>">新しい <%= @depleted_lots.size %> 件だけを表示しています。</p>
      <% end %>
    </details>
  <% end %>
</section>

<section class="mt-4 rounded-xl border border-slate-200 bg-white p-4" aria-label="分類">
  <h2 class="font-bold text-slate-900">分類</h2>
  <dl class="mt-3 space-y-2 text-sm">
    <div class="flex justify-between gap-2">
      <dt class="text-slate-500">カテゴリ</dt>
      <dd class="text-slate-900"><%= @item.category&.name || "未設定" %></dd>
    </div>
    <div class="flex justify-between gap-2">
      <dt class="text-slate-500">保管場所</dt>
      <dd class="text-slate-900"><%= @item.storage_location&.name || "未設定" %></dd>
    </div>
  </dl>
</section>

<section class="mt-4 rounded-xl border border-slate-200 bg-white p-4" aria-label="設定">
  <h2 class="font-bold text-slate-900">設定</h2>
  <dl class="mt-3 space-y-2 text-sm">
    <div class="flex justify-between gap-2">
      <dt class="text-slate-500">入数の既定値</dt>
      <dd class="text-slate-900">
        <%= @item.default_pack_size.present? ? "#{@item.default_pack_size} #{@item.unit}" : "未設定" %>
      </dd>
    </div>
    <div class="flex justify-between gap-2">
      <dt class="text-slate-500">予測モード</dt>
      <dd class="text-slate-900"><%= item_estimation_mode_label(@item) %></dd>
    </div>
    <% if @item.estimation_mode_manual? %>
      <div class="flex justify-between gap-2">
        <dt class="text-slate-500">使用間隔</dt>
        <dd class="text-slate-900">
          <%= @item.manual_interval_days.present? ? "1 #{@item.unit} を #{@item.manual_interval_days} 日" : "未設定" %>
        </dd>
      </div>
    <% end %>
    <div class="flex justify-between gap-2">
      <dt class="text-slate-500">そろそろ購入</dt>
      <dd class="text-slate-900">残り <%= @item.effective_soon_threshold_days %> 日</dd>
    </div>
    <div class="flex justify-between gap-2">
      <dt class="text-slate-500">購入推奨</dt>
      <dd class="text-slate-900">残り <%= @item.effective_urgent_threshold_days %> 日</dd>
    </div>
    <div class="flex justify-between gap-2">
      <dt class="text-slate-500">期限の管理</dt>
      <dd class="text-slate-900">
        <%= @item.tracks_expiry? ? "する (#{@item.effective_expiry_warning_days} 日前から警告)" : "しない" %>
      </dd>
    </div>
    <div class="flex justify-between gap-2">
      <dt class="text-slate-500">用途の管理</dt>
      <dd class="text-slate-900"><%= @item.tracks_purposes? ? "する" : "しない" %></dd>
    </div>
  </dl>

  <% if @item.note.present? %>
    <div class="mt-4 border-t border-slate-200 pt-3">
      <p class="text-sm text-slate-500">メモ</p>
      <p class="mt-1 whitespace-pre-line text-sm text-slate-900"><%= @item.note %></p>
    </div>
  <% end %>
</section>

<% unless @item.archived? %>
  <section class="mt-6 rounded-xl border border-slate-200 bg-white p-4">
    <h2 class="font-bold text-slate-900">この品目をアーカイブ</h2>
    <p class="<%= hint_classes %>">
      一覧から外れますが、記録は残ります。品目は削除できません。
    </p>
    <%= button_to "アーカイブする", item_archive_path(@item), method: :post,
          form: { data: { turbo_confirm: "「#{@item.name}」をアーカイブします。よろしいですか?" } },
          class: danger_button_classes("mt-3") %>
  </section>
<% end %>
