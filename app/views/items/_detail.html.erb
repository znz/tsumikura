<%#
  品目詳細の「動く」部分 (在庫・ロット・用途・最近の記録)。
  ワンタップ使用の Turbo Stream がここを丸ごと差し替えるので、
  ItemDetails#load_item_detail が用意した ivar をそのまま使う。
%>
<section class="mt-4 rounded-xl border border-slate-200 bg-white p-4" aria-label="在庫">
  <p class="text-sm text-slate-500">在庫数</p>
  <p class="mt-1">
    <span class="text-4xl font-bold text-slate-900"><%= @item.current_quantity %></span>
    <span class="ml-1 text-lg text-slate-600"><%= @item.unit %></span>
  </p>
  <% if @item.minimum_quantity.present? %>
    <p class="<%= hint_classes %>">最低在庫数: <%= @item.minimum_quantity %> <%= @item.unit %></p>
  <% end %>

  <div class="mt-4 flex gap-2">
    <%# 用途を管理する品目では「使った」も同じフォームに行くので、片方だけ出す %>
    <% unless @item.tracks_purposes? %>
      <%= render "items/use_button", item: @item %>
    <% end %>
    <%= link_to "使用を記録", new_item_usage_record_path(@item),
          class: secondary_button_classes("flex-1") %>
  </div>

  <%= link_to "購入を記録", new_item_lot_path(@item),
        class: primary_button_classes("mt-2 block text-center") %>
  <%# 期限切れ・破損・紛失は「使った」ではないので廃棄で記録する %>
  <%= link_to "廃棄を記録", new_item_disposal_path(@item),
        class: secondary_button_classes("mt-2") %>

  <%#
    買い物リストへの手動追加 (docs/spec/01-domain-model.md 判断 5)。
    すでに要購入で自動的に並んでいる品目なら、行は増えず「すでにあります」と伝える。
    アーカイブ済みの品目は買い物リストに出さないので、ボタンも出さない
  %>
  <% unless @item.archived? %>
    <%= button_to "買い物リストに追加", shopping_list_items_path,
          params: { shopping_list_item: { item_id: @item.id, manual: "true" } },
          class: secondary_button_classes("mt-2 w-full cursor-pointer") %>
  <% end %>
</section>

<%#
  要購入の予測 (docs/spec/03-screens.md 画面 3)。
  ペースが分かっていれば reason によらず在庫切れ予測日を出す (仕様 7 節)。
  分からないときは「何がたまれば予測が始まるか」を出して不安にさせない。
%>
<section class="mt-4 rounded-xl border border-slate-200 bg-white p-4" aria-label="予測">
  <div class="flex items-start justify-between gap-2">
    <h2 class="font-bold text-slate-900">要購入の予測</h2>
    <%# 詳細では「購入不要」も文字で出す (判定が何も出ていないように見えないように) %>
    <%= render "items/status_badges", forecast: @forecast, expiry: @expiry, show_ok: true %>
  </div>

  <% if @forecast.pace.known? %>
    <%#
      在庫が残っているのに予測日が today に丸められた状態 (仕様 9 節) は、
      「在庫 5 なのに在庫切れ予測日が今日」と読めて誤解を生む。日付を主役にせず、
      「ペースどおりなら使い切っている時期」であることと、棚卸の導線を出す。
    %>
    <% if forecast_overdue?(@forecast) %>
      <p class="mt-3 font-bold text-slate-900">買っておくべき期限はすでに過ぎています。</p>
      <p class="<%= hint_classes %>">
        予測日は <%= l(@forecast.need_by_on) %> でした。ふだんのペースなら使い切っている時期です。
        在庫数が合っているか確認してください (棚卸)。
      </p>
    <% else %>
      <p class="mt-3 text-slate-900">
        在庫切れ予測日:
        <span class="font-bold"><%= l(@forecast.need_by_on) %></span>
        (<%= forecast_days_left_text(@forecast) %>)
      </p>
      <p class="<%= hint_classes %>">「次に使いたいときに未使用在庫が無くなる日」です。</p>
    <% end %>
    <p class="mt-2 text-sm text-slate-700">
      ペース: <%= forecast_pace_text(@forecast.pace, @item.unit) %>
    </p>
  <% else %>
    <%# 何がたまれば予測が始まるかを出して不安にさせない %>
    <p class="mt-3 text-sm text-slate-700"><%= forecast_unknown_text(@item, @forecast) %></p>
  <% end %>

  <% if (reason = forecast_reason_text(@item, @forecast)) %>
    <p class="mt-2 text-sm text-slate-700"><%= reason %></p>
  <% end %>

  <% if @item.minimum_quantity.present? %>
    <p class="<%= hint_classes %>">
      最低在庫数 <%= @item.minimum_quantity %> <%= @item.unit %> ちょうどで「そろそろ購入」、
      下回ると「購入推奨」になります。
    </p>
  <% end %>
  <% if @expiry.expired_count.positive? %>
    <p class="<%= hint_classes %>">
      期限切れの <%= @expiry.expired_count %> ロットは、この判定の在庫に数えていません。
    </p>
  <% end %>
</section>

<%# 期限の状態 (docs/spec/02-forecast.md 12 節)。期限を入れたロットが 1 つも無ければ出さない %>
<% if @expiry.nearest_expires_on %>
  <section class="mt-4 rounded-xl border border-slate-200 bg-white p-4" aria-label="期限">
    <div class="flex items-start justify-between gap-2">
      <h2 class="font-bold text-slate-900">期限</h2>
      <%= render "items/status_badges", expiry: @expiry %>
    </div>
    <p class="mt-3 text-sm text-slate-700">
      最も近い期限: <span class="font-medium"><%= l(@expiry.nearest_expires_on) %></span>
    </p>
    <% if @expiry.expired_count.positive? %>
      <p class="mt-1 text-sm text-red-700">期限切れのロット: <%= @expiry.expired_count %> 件</p>
      <%= link_to "廃棄を記録", new_item_disposal_path(@item),
            class: secondary_button_classes("mt-3 text-red-700") %>
    <% elsif @expiry.expiring_soon_count.positive? %>
      <p class="mt-1 text-sm text-slate-700">期限が近いロット: <%= @expiry.expiring_soon_count %> 件</p>
    <% end %>
  </section>
<% end %>

<%# ロットは期限が近い順 (FEFO)。使い切ったロットは畳んでおく (docs/spec/01-domain-model.md 判断 2) %>
<section class="mt-4 rounded-xl border border-slate-200 bg-white p-4" aria-label="ロット">
  <h2 class="font-bold text-slate-900">ロット</h2>
  <% if @average_unit_price_yen %>
    <p class="<%= hint_classes %>">
      最近の単価: 平均 <%= unit_price_text(@average_unit_price_yen, @item.unit) %>
      <span class="text-slate-400">(価格を記録した直近 <%= Lot::RECENT_PRICED_LOTS %> 件)</span>
    </p>
  <% end %>

  <% if @available_lots.any? %>
    <ul class="mt-3 divide-y divide-slate-200" aria-label="ロット一覧">
      <% @available_lots.each do |lot| %>
        <%= render "lots/lot", lot: lot, item: @item, today: @today %>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-3 text-sm text-slate-600">在庫のあるロットはまだありません。</p>
  <% end %>

  <% if @depleted_lots.any? %>
    <details class="group mt-3 border-t border-slate-200 pt-3">
      <summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 py-2 text-sm font-medium text-slate-700">
        <span class="text-slate-400 transition-transform group-open:rotate-90" aria-hidden="true">▶</span>
        <span>使い切ったロット (<%= @depleted_lots_count %> 件)</span>
      </summary>
      <ul class="divide-y divide-slate-200" aria-label="使い切ったロット一覧">
        <% @depleted_lots.each do |lot| %>
          <%= render "lots/lot", lot: lot, item: @item, today: @today %>
        <% end %>
      </ul>
      <% if @depleted_lots_count > @depleted_lots.size %>
        <p class="<%= hint_classes %>">新しい <%= @depleted_lots.size %> 件だけを表示しています。</p>
      <% end %>
    </details>
  <% end %>
</section>

<%# 用途は履歴と交換周期の表示専用 (docs/spec/01-domain-model.md 判断 4) %>
<% if @item.tracks_purposes? %>
  <section class="mt-4 rounded-xl border border-slate-200 bg-white p-4" aria-label="用途">
    <div class="flex items-center justify-between gap-2">
      <h2 class="font-bold text-slate-900">用途</h2>
      <%= link_to "用途を管理", item_purposes_path(@item), class: secondary_button_classes("shrink-0") %>
    </div>

    <% if @purposes.any? %>
      <ul class="mt-3 divide-y divide-slate-200" aria-label="用途一覧">
        <% @purposes.each do |purpose| %>
          <li class="py-3">
            <p class="font-medium text-slate-900"><%= purpose.name %></p>
            <p class="mt-1 text-sm text-slate-500">
              <% if purpose.last_used_on %>
                最終交換日: <%= l(purpose.last_used_on) %>
                <% if (interval = purpose.replacement_interval_days) %>
                  ・ 交換周期: 約 <%= interval %> 日
                <% else %>
                  ・ 交換周期は 2 回目の記録から出ます
                <% end %>
              <% else %>
                まだ使用の記録がありません
              <% end %>
            </p>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-3 text-sm text-slate-600">まだ用途がありません。</p>
    <% end %>
  </section>
<% end %>

<%# 使用・購入・廃棄・棚卸の調整を時系列で混ぜる (docs/spec/03-screens.md 画面 3) %>
<section class="mt-4 rounded-xl border border-slate-200 bg-white p-4" aria-label="最近の記録">
  <h2 class="font-bold text-slate-900">最近の記録</h2>

  <% if @recent_records.empty? %>
    <p class="mt-3 text-sm text-slate-600">まだ記録がありません。</p>
  <% else %>
    <ul class="mt-3 divide-y divide-slate-200" aria-label="最近の記録一覧">
      <% @recent_records.each do |record| %>
        <%= render "items/recent_record", record: record, item: @item %>
      <% end %>
    </ul>

    <%#
      11 件目が引けたときだけ全履歴への導線を出す (画面 3b)。
      文言に総件数は入れない (数えるための COUNT を毎回足すことになるため)
    %>
    <% if @recent_records_truncated %>
      <p class="mt-3 border-t border-slate-200 pt-3 text-sm">
        <%= link_to "もっと見る", item_records_path(@item), class: "text-blue-600 underline" %>
      </p>
    <% end %>
  <% end %>
</section>
