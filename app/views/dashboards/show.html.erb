<% content_for :title, "ホーム" %>

<div class="flex items-baseline justify-between gap-2">
  <h1 class="text-2xl font-bold text-slate-900">つみくら</h1>
  <p class="text-sm text-slate-500">ようこそ、<%= Current.user.name %>。</p>
</div>

<%# (1) アラートカード 4 種 %>
<%= render "dashboards/alerts" %>

<%# 「購入推奨」「そろそろ購入」からの導線 (買い物リストは同じ判定から並ぶ) %>
<%= link_to "買い物リストを開く", shopping_list_path,
      class: secondary_button_classes("mt-3 w-full") %>

<%# (2) クイック使用 (お気に入り + 最近使った品目) %>
<section class="mt-6" aria-label="クイック使用">
  <div class="flex items-center justify-between gap-2">
    <h2 class="font-bold text-slate-900">クイック使用</h2>
    <%= link_to "品目一覧", items_path, class: "text-sm text-blue-600 underline" %>
  </div>

  <% if @quick_use_items.any? %>
    <ul class="mt-3 grid grid-cols-2 gap-3" aria-label="クイック使用の品目">
      <% @quick_use_items.each do |item| %>
        <%= render "dashboards/quick_use_item", item: item,
              forecast: @forecasts[item.id], expiry: @expiries[item.id] %>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-3 rounded-xl border border-slate-200 bg-white p-4 text-sm text-slate-600">
      よく使う品目に ★ を付けると、ここから 1 タップで記録できます。
    </p>
  <% end %>
</section>

<%# (3) 最近の記録 5 件 (全品目横断) %>
<%= render "dashboards/recent_records" %>
