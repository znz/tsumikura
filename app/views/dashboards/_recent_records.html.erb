<%#
  最近の記録 5 件 (全品目横断)。行は品目詳細と同じ部分テンプレートを使い回す。
  ダッシュボードからワンタップで使ったときは、このセクションごと差し替える。
%>
<section id="recent_records" class="mt-6 rounded-xl border border-slate-200 bg-white p-4"
         aria-label="最近の記録">
  <h2 class="font-bold text-slate-900">最近の記録</h2>

  <% if @dashboard_recent_records.empty? %>
    <p class="mt-3 text-sm text-slate-600">まだ記録がありません。</p>
  <% else %>
    <ul class="mt-3 divide-y divide-slate-200" aria-label="最近の記録一覧">
      <% @dashboard_recent_records.each do |record| %>
        <%= render "items/recent_record", record: record, item: record.item, show_item: true %>
      <% end %>
    </ul>
  <% end %>
</section>
